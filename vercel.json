{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "panel": {
      "root": "apps/panel",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/panel", "destination": { "service": "panel" } },
    { "source": "/panel/(.*)", "destination": { "service": "panel" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
