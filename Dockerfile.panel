# Panel de la demo en un solo proceso: el estado de la demo vive en memoria, por eso NO sirve para serverless.
# Build:  docker build -f Dockerfile.panel -t genesis-panel .
# Run:    docker run -p 3001:3001 -e DEMO_PASSWORD= genesis-panel   (sin DEMO_PASSWORD el login es el botón "Entrar a la demo")
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci
ENV STANDALONE=1 NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace @genesis/panel

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3001 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/apps/panel/.next/standalone ./
COPY --from=build /app/apps/panel/.next/static ./apps/panel/.next/static
COPY --from=build /app/apps/panel/public ./apps/panel/public
EXPOSE 3001
CMD ["node", "apps/panel/server.js"]
