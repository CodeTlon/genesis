# Copiar a .env en la raíz (local) o cargar en el entorno del compose. Nunca commitear valores reales.
# Cada entorno (dev local, test, producción) tiene SUS PROPIOS valores; las claves no se reutilizan entre entornos.

# --- Base de datos ---
DATABASE_URL=postgres://genesis:genesis@localhost:5433/genesis

# --- Autenticación (Better Auth) ---
BETTER_AUTH_SECRET=            # obligatoria en producción, >= 32 caracteres: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000   # URL pública de la app

# --- Cifrado de datos clínicos (AES-256-GCM) ---
# OBLIGATORIA. 32 bytes en base64: openssl rand -base64 32
# Guardarla en el gestor de secretos, FUERA del repo y del backup de la base. Si se pierde, los datos cifrados son irrecuperables.
CLINICAL_DATA_ENCRYPTION_KEY=

# --- Fotos clínicas (volumen privado, nunca dentro de public/) ---
PHOTOS_DIR=./.data/clinico
