# Copiar a .env.local en cada app. Nunca commitear valores reales.
DATABASE_URL=postgres://genesis:genesis@localhost:5432/genesis   # web y panel (misma base)
DEMO_PASSWORD=cambiar-esto                                        # panel: contraseña única de la demo
WEB_URL=http://localhost:3000                                     # panel: dirección del sitio (para refrescarlo al guardar y los links "Ver en el sitio")
REVALIDATE_SECRET=cambiar-esto                                    # igual en web y panel
NEXT_PUBLIC_SITE_URL=https://genesis-demo.vercel.app              # web: URL pública (sitemap, Open Graph)
SITE_INDEXABLE=0                                                  # web: 1 solo en producción (la demo va noindex)
