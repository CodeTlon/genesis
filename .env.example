# Copiar a .env.local en apps/web. Nunca commitear valores reales.
# La app es una sola (sitio en / y panel en /panel): para la demo no hace falta ninguna variable.
NEXT_PUBLIC_SITE_URL=https://genesis-demo.vercel.app              # URL pública (sitemap, Open Graph)
SITE_INDEXABLE=0                                                  # 1 solo en producción (la demo va noindex)
# --- Opcionales ---
DEMO_PASSWORD=                                                    # si se define, el panel la exige (vacío = acceso libre con perfiles ficticios)
DATABASE_URL=postgres://genesis:genesis@localhost:5432/genesis   # sin esto, en producción el sitio usa los textos por defecto y "Sitio web" del panel no guarda cambios
