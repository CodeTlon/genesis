# Copiar a .env.local en cada app. Nunca commitear valores reales.
# --- Demo pública sin base de datos (lo mínimo) ---
# Panel (Docker, un solo proceso): no hace falta ninguna variable. El login es el botón "Entrar a la demo".
# Web (Vercel): NEXT_PUBLIC_SITE_URL y, si querés el link al panel, PANEL_URL.
NEXT_PUBLIC_SITE_URL=https://genesis-demo.vercel.app              # web: URL pública (sitemap, Open Graph)
SITE_INDEXABLE=0                                                  # web: 1 solo en producción (la demo va noindex)
# --- Opcionales ---
DEMO_PASSWORD=                                                    # panel: si se define, el login la exige (vacío = acceso libre con perfiles ficticios)
DATABASE_URL=postgres://genesis:genesis@localhost:5432/genesis   # web y panel (misma base). Sin esto, en producción el sitio usa los textos por defecto y /sitio queda sin guardar
WEB_URL=http://localhost:3000                                     # panel: dirección del sitio (links "Ver en el sitio" y refresco al guardar)
REVALIDATE_SECRET=cambiar-esto                                    # igual en web y panel; sin esto el refresco inmediato queda desactivado en producción
